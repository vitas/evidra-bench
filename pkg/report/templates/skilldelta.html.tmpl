<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Skill Delta Benchmark</title>
  <style>
    :root {
      --bg: #f4f0e8;
      --surface: #fffaf0;
      --surface-strong: #efe6d2;
      --ink: #1e1b16;
      --muted: #5f5a50;
      --line: #d8ccb6;
      --accent: #1b7f6b;
      --danger: #9b3d2f;
      --shadow: 0 20px 60px rgba(64, 49, 24, 0.10);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Avenir Next", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(27,127,107,0.12), transparent 28%),
        linear-gradient(180deg, #fbf7ef 0%, var(--bg) 100%);
    }
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 20px 56px;
    }
    h1, h2 {
      font-family: "IBM Plex Serif", Georgia, serif;
      margin: 0 0 12px;
    }
    p.meta {
      margin: 0 0 24px;
      color: var(--muted);
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin: 0 0 28px;
    }
    .card, section {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
    }
    .card {
      padding: 16px;
    }
    .card .label {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .card .value {
      font-size: 1.8rem;
      font-weight: 700;
    }
    section {
      padding: 20px;
      margin-bottom: 22px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 12px 10px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
    }
    th {
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
    }
    tbody tr:last-child td {
      border-bottom: none;
    }
    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 16px;
    }
    .toolbar input {
      width: min(340px, 100%);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 10px 14px;
      background: #fff;
      color: var(--ink);
    }
    .verdict-pass { color: var(--accent); font-weight: 700; }
    .verdict-fail { color: var(--danger); font-weight: 700; }
    .signals {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .signals span {
      background: var(--surface-strong);
      border-radius: 999px;
      padding: 4px 8px;
      font-size: 0.78rem;
    }
    a {
      color: var(--accent);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    @media (max-width: 860px) {
      .toolbar { flex-direction: column; align-items: stretch; }
      table, thead, tbody, th, td, tr { display: block; }
      thead { display: none; }
      tr {
        border: 1px solid var(--line);
        border-radius: 14px;
        margin-bottom: 12px;
        overflow: hidden;
        background: rgba(255,255,255,0.55);
      }
      td {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 12px;
      }
      td::before {
        content: attr(data-label);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        color: var(--muted);
      }
    }
  </style>
</head>
<body>
  <main>
    <h1>Skill Delta Benchmark</h1>
    <p class="meta">Generated: {{ .GeneratedAt }} • Pairs: {{ .PairCount }}</p>

    <div class="cards">
      {{ range .Cards }}
      <div class="card">
        <div class="label">{{ .Label }}</div>
        <div class="value">{{ .Value }}</div>
      </div>
      {{ end }}
    </div>

    <section>
      <h2>Aggregate Summary</h2>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>Without skill</th>
            <th>With skill</th>
            <th>Delta</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Summary }}
          <tr>
            <td data-label="Metric">{{ .Label }}</td>
            <td data-label="Without skill">{{ .Without }}</td>
            <td data-label="With skill">{{ .With }}</td>
            <td data-label="Delta">{{ .Delta }}</td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </section>

    <section>
      <div class="toolbar">
        <div>
          <h2>Pairs</h2>
          <p class="meta">Filter the table by scenario, model, or signal name.</p>
        </div>
        <input id="pair-filter" type="search" placeholder="Filter pairs">
      </div>
      <table>
        <thead>
          <tr>
            <th>Scenario</th>
            <th>Model</th>
            <th>Repeat</th>
            <th>Without</th>
            <th>With</th>
            <th>Compliance Δ</th>
            <th>Token Δ</th>
            <th>Cost Δ</th>
            <th>Score Δ</th>
            <th>Signals</th>
            <th>Artifacts</th>
          </tr>
        </thead>
        <tbody id="pair-table">
          {{ range .Pairs }}
          <tr data-search="{{ .ScenarioID }} {{ .Model }} {{ .WithBand }} {{ range .Signals }}{{ . }} {{ end }}">
            <td data-label="Scenario">{{ .ScenarioID }}</td>
            <td data-label="Model">{{ .Model }}</td>
            <td data-label="Repeat">{{ .Repeat }}</td>
            <td data-label="Without"><span class="{{ if eq .WithoutVerdict "PASS" }}verdict-pass{{ else }}verdict-fail{{ end }}">{{ .WithoutVerdict }}</span></td>
            <td data-label="With"><span class="{{ if eq .WithVerdict "PASS" }}verdict-pass{{ else }}verdict-fail{{ end }}">{{ .WithVerdict }}</span></td>
            <td data-label="Compliance Δ">{{ .ComplianceDelta }}</td>
            <td data-label="Token Δ">{{ .TokenDelta }}</td>
            <td data-label="Cost Δ">{{ .CostDelta }}</td>
            <td data-label="Score Δ">{{ .ScoreDelta }}</td>
            <td data-label="Signals">
              <div class="signals">
                {{ range .Signals }}<span>{{ . }}</span>{{ end }}
              </div>
            </td>
            <td data-label="Artifacts">
              {{ if .WithoutRunLink }}<div><a href="{{ .WithoutRunLink }}">without_skill</a></div>{{ end }}
              {{ if .WithRunLink }}<div><a href="{{ .WithRunLink }}">with_skill</a></div>{{ end }}
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
    </section>
  </main>
  <script>
    const filterInput = document.getElementById("pair-filter");
    const rows = Array.from(document.querySelectorAll("#pair-table tr"));
    filterInput?.addEventListener("input", () => {
      const needle = filterInput.value.trim().toLowerCase();
      rows.forEach((row) => {
        const haystack = (row.getAttribute("data-search") || "").toLowerCase();
        row.style.display = needle === "" || haystack.includes(needle) ? "" : "none";
      });
    });
  </script>
</body>
</html>
