# Bench Lab — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# LLM provider gateway (OpenAI-compatible endpoint)
INFRA_BENCH_BIFROST_URL=https://api.openrouter.ai/v1
INFRA_BENCH_BIFROST_AUTH_BEARER=
INFRA_BENCH_BIFROST_RPM=

# Bench API (for reporting benchmark results)
BENCH_API_URL=https://api.evidra.cc
BENCH_API_KEY=

# Local Bench API service
BENCH_DATABASE_URL=postgres://bench:bench@localhost:5432/bench?sslmode=disable
BENCH_SERVICE_ADDR=:8090

# Lab UI build
VITE_BENCH_API_URL=https://api.evidra.cc
