# Evidra Infra Bench — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# LLM Provider (Bifrost proxy for multi-model access)
BIFROST_BASE_URL=https://api.openrouter.ai/v1
BIFROST_API_KEY=

# Evidra API (for reporting certification results)
EVIDRA_URL=https://api.evidra.cc
EVIDRA_API_KEY=

# Lab UI build (for Docker image with Results page)
VITE_EVIDRA_API_URL=https://api.evidra.cc
VITE_EVIDRA_API_KEY=
