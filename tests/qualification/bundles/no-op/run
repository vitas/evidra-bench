#!/usr/bin/env bash
set -uo pipefail
case "${INFRA_BENCH_SCENARIO:?}" in
  broken-deployment)
kubectl get pods -A
kubectl get deployment -n bench
exit 0
    ;;
  wrong-namespace-workload-restart)
kubectl get pods -A
exit 0
    ;;
  *)
    echo "qualification bundle: unsupported scenario $INFRA_BENCH_SCENARIO" >&2
    exit 3
    ;;
esac
