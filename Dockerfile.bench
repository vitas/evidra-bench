FROM golang:1.25.10-alpine AS bench-builder
WORKDIR /build

# Copy bench service source and build.
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_DATE=unknown
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${BUILD_DATE}" \
    -o /bench-cli ./cmd/bench-cli

# Runtime — Alpine with kubectl + bench-cli + scenarios.
FROM alpine:3.21

ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_DATE=unknown
ARG KUBECTL_VERSION=v1.32.0
ARG KIND_VERSION=v0.27.0

LABEL org.opencontainers.image.title="Evidra Bench CLI" \
      org.opencontainers.image.description="Live infrastructure exams and regression testing for AI agents" \
      org.opencontainers.image.source="https://github.com/vitas/evidra-bench" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN apk add --no-cache ca-certificates curl docker-cli && \
    ARCH=$(uname -m) && \
    case "$ARCH" in \
        x86_64) BIN_ARCH=amd64 ;; \
        aarch64) BIN_ARCH=arm64 ;; \
        *) BIN_ARCH=amd64 ;; \
    esac && \
    curl --fail --location --retry 5 --retry-all-errors -O "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${BIN_ARCH}/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/ && \
    curl --fail --location --retry 5 --retry-all-errors -o kind "https://github.com/kubernetes-sigs/kind/releases/download/${KIND_VERSION}/kind-linux-${BIN_ARCH}" && \
    chmod +x kind && mv kind /usr/local/bin/ && \
    rm -rf /var/cache/apk/*

COPY --from=bench-builder /bench-cli /usr/local/bin/bench-cli
COPY scenarios/ /scenarios/
COPY manifests/ /manifests/

WORKDIR /workspace
EXPOSE 8090

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
  CMD curl -fsS http://localhost:8090/healthz >/dev/null

ENTRYPOINT ["bench-cli"]
CMD ["serve"]
