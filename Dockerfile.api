# ── UI build stage ──
FROM node:22-alpine AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ .
RUN npm run build

# ── Go build stage ──
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui-builder /ui/dist ./ui/dist
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -tags embed_ui \
    -ldflags="-s -w" \
    -o /bench-api ./cmd/bench-api

# ── Runtime stage (all-in-one demo) ──
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /bench-api /usr/local/bin/bench-api
COPY runs/ /data/runs/
COPY scenarios/ /data/scenarios/

ENV RUNS_DIR=/data/runs
ENV SCENARIOS_DIR=/data/scenarios
ENV LISTEN_ADDR=:8080
ENV READONLY=1

EXPOSE 8080
ENTRYPOINT ["bench-api"]
CMD ["--readonly"]
