# ── UI build stage ──
FROM node:22-alpine AS ui-builder
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ .
RUN npm run build

# ── Go build stage ──
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src

# Copy parent repo for replace directive (samebits.com/evidra => ../evidra-benchmark)
# In CI: passed via --build-context parent=evidra-benchmark
# Locally: passed via --build-context parent=../evidra-benchmark
COPY --from=parent . /evidra-benchmark/

COPY go.mod go.sum ./

# Rewrite replace directive to match build layout
RUN sed -i 's|=> ../evidra-benchmark|=> /evidra-benchmark|' go.mod
RUN go mod download

COPY . .
COPY --from=ui-builder /ui/dist ./ui/dist

# Inject version at build time
ARG VERSION=dev
ARG COMMIT=unknown

# Build both binaries
RUN CGO_ENABLED=0 GOOS=linux go build \
    -tags embed_ui \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /bench-api ./cmd/bench-api

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /infra-bench ./cmd/infra-bench

# ── Data stage: rebuild DB from committed JSONL ──
FROM builder AS data-builder
RUN mkdir -p /data/runs
COPY runs/results.jsonl /data/runs/results.jsonl
RUN /infra-bench db rebuild --runs-dir /data/runs

# ── Runtime stage (all-in-one demo) ──
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /bench-api /usr/local/bin/bench-api
COPY scenarios/ /data/scenarios/

# Bundle run artifacts (transcripts, tool-calls, scorecards) for timeline/transcript UI
COPY runs/ /data/runs/

# Overwrite DB with rebuilt version (from JSONL, includes all imported records)
COPY --from=data-builder /data/runs/bench.db /data/runs/bench.db

ENV RUNS_DIR=/data/runs
ENV SCENARIOS_DIR=/data/scenarios
ENV LISTEN_ADDR=:8080
ENV READONLY=1

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["bench-api"]
CMD ["--readonly"]
